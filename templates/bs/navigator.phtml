<script>

const map = new mapboxgl.Map({
    accessToken: '<?php echo \Fado\Model\Setting::get('map_route_url'); ?>',
    container: 'map',
    style: 'mapbox://styles/mapbox/standard',
    config: {
        basemap: {
            lightPreset: "dawn",
            colorRoads: "#ffe600",
            font: "Open Sans",
            show3dTrees: false,
            showLandmarkIcons: true,
            showHdRoads: true,
            colorHdRoads: "#ffcc00"
        }
    },
    center: [-0.118092, 51.509865],
    zoom: 12,
    bearing: 0.00,
    pitch: 0.00,
});

var directions = new MapboxDirections({
    accessToken: '<?php echo \Fado\Model\Setting::get('map_route_url'); ?>',
    unit: 'metric',
    profile: 'mapbox/driving'
});
map.addControl(directions);

function selectRoute() {
   var waypoints = [];
   $('.route-select option').each(function (i) {
       if (this.selected) {
           waypoints.push([parseFloat(this.dataset.lng), parseFloat(this.dataset.lat)]);
        }
   });
   for (var i = 0; i < waypoints.length; i++) {
        if (i == 0) {
            directions.setOrigin(waypoints[i]);
        } else if (i < (waypoints.length - 1)) {
            directions.addWaypoint(i - 1, waypoints[i]);
        } else {
            directions.setDestination(waypoints[i]);
        }
    }
    var linkSuffix = '?';
    for (var i = 0; i < waypoints.length; i++) {
        linkSuffix += waypoints[i].lat.toString() + ',' + waypoints[i].lng.toString();
        if (i + 1 != waypoints.length) {
            linkSuffix += ';';
        }
     }
     $('#pdflink').attr('href', $('#pdflink').attr('href') + linkSuffix);
     $('#printlink').attr('href', $('#printlink').attr('href') + linkSuffix);
}

selectRoute();

$('.route-select').on('change', function() {
     selectRoute();
});

</script>

